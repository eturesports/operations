// ETURE Sports Database — Prisma schema
// Base de datos: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
//  Auth.js (NextAuth) — modelos estándar
// ─────────────────────────────────────────────

enum Role {
  ADMIN // gestiona usuarios y permisos, y todo lo demás
  EDITOR // puede crear/editar/borrar jugadores
  COLLABORATOR // puede modificar lo que ya existe, pero no crear ni borrar jugadores
  VIEWER // solo lectura
}

enum ClaimStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

// Official, versioned marketing claims (framework cap. 17): every public figure
// as a record with definition, denominator, source, coverage and cutoff date.
model Claim {
  id            String      @id @default(cuid())
  text          String      @db.Text
  metric        String?
  definition    String?     @db.Text
  population    String?
  period        String?
  denominator   String?
  source        String?
  coverage      String?
  authorizedUse String? // comma list: web, social, dossier, sales, PR
  owner         String?
  status        ClaimStatus @default(DRAFT)
  asOf          DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(VIEWER)
  active        Boolean   @default(true)
  approved      Boolean   @default(false) // access requires admin approval unless auto-approved by domain/allowlist
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  createdPlayers Player[]          @relation("PlayerCreatedBy")
  updatedPlayers Player[]          @relation("PlayerUpdatedBy")
  shareLinks     PlayerShareLink[] @relation("ShareLinkCreatedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
//  Dominio: deportes y jugadores
// ─────────────────────────────────────────────

model Sport {
  id        String   @id @default(cuid())
  code      String   @unique // MSOC, WSOC…
  name      String // Fútbol masculino, Fútbol femenino…
  order     Int      @default(0)
  createdAt DateTime @default(now())

  players Player[]
}

/// One human being. Operations are what Eture did; a Person is who it was
/// done for, and the only thing that survives a change of university.
model Person {
  id      String   @id @default(cuid())
  name    String
  players Player[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Player {
  id           String  @id @default(cuid())
  sportId      String
  sport        Sport   @relation(fields: [sportId], references: [id], onDelete: Restrict)
  /// Who this operation was for. Records sharing a person are one career.
  personId     String?
  person       Person? @relation(fields: [personId], references: [id])
  name         String
  university   String?
  season       String? // temporada, ej. "24/25"
  division     String? // Division I/II/III, JUCO, NAIA III, MLS NEXT PRO…
  program      String? // "Becas EEUU", "Gap Year / Eture FC"…
  scholarship  Int? // beca total en USD
  notes        String? @db.Text
  legacyNumber Int? // número original (#) en el Excel
  active       Boolean @default(true)

  // Media & links
  profileImageUrl String? // headshot / profile photo
  actionImageUrl  String? // in-game / action photo
  ncaaUrl         String? // NCAA profile / roster page
  instagramUrl    String? // Instagram handle URL

  // Segmentation (framework cap. 7)
  nationality  String?
  position     String? // GK, DF, MF, FW…
  previousClub String?

  // Outcome: did the player finish their degree, and when
  graduated      Boolean @default(false)
  graduationYear Int?

  // Won an NCAA national championship with their university
  nationalChampion Boolean @default(false)

  // Drafted into MLS: once, to the person, at the end of their college years.
  // Mirrored across their operations like nationality, so every count of it
  // must count people rather than records.
  mlsDraftYear  Int?
  mlsDraftClub  String?
  mlsDraftRound Int?
  mlsDraftPick  Int?

  // A scholarship covering the full cost of attendance, not a part of it
  fullRide Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("PlayerCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?    @relation("PlayerUpdatedBy", fields: [updatedById], references: [id])

  profiles     PlayerProfile[]
  shareLinks   PlayerShareLink[]
  achievements Achievement[]

  @@index([sportId])
  @@index([season])
  @@index([division])
  @@index([program])
}

// A player's stint at a university (a player may have several — transfers).
// Stats can be edited by hand or refreshed from the public NCAA stats API.
// Something a player did that a number does not capture: a conference award,
// a school record, an academic honour. Free text on purpose — these come from
// college bios written in prose, and forcing them into fields would lose most
// of what makes them worth keeping.
model Achievement {
  id       String @id @default(cuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  season String? // "2019" or "19/20" — whatever the source used
  kind   String? // Award | Record | Academic | Milestone | Other
  text   String  @db.Text
  source String? // where it was read, usually their college bio

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([playerId])
}

model PlayerProfile {
  id       String @id @default(cuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  university String
  division   String? // Division I/II/III, JUCO, NAIA…
  season     String? // "24/25"
  current    Boolean @default(false) // the player's current/active roster
  jersey     String? // shirt number

  // NCAA linkage (henrygd/ncaa-api)
  ncaaSport    String? @default("soccer-men") // soccer-men | soccer-women
  ncaaDivision String? @default("d1") // d1 | d2 | d3
  rosterUrl    String? // roster / profile page

  // What this university agreed to fund. A player is offered a different
  // amount by each college, so the figure belongs here and the player record
  // mirrors whichever stint is current.
  scholarship Int?
  fullRide    Boolean @default(false)

  // Won with this team, in this season. The conference name is kept rather
  // than derived: a school's soccer conference can differ from its primary
  // one, and conferences realign — the record should keep saying what was won.
  conferenceChampion Boolean @default(false)
  conferenceName     String?

  // Taken in this university's shirt, so it belongs to this stint
  profileImageUrl String?
  actionImageUrl  String?

  // Season stats (outfield + goalkeeper)
  matchesPlayed  Int?
  matchesStarted Int?
  minutes        Int?
  goals          Int?
  assists        Int?
  points         Int?
  saves          Int?
  goalsAgainst   Int?

  statsUpdatedAt DateTime?
  statsSource    String? // "manual" | "ncaa-api"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seasonStats ProfileSeasonStat[]

  @@index([playerId])
  @@index([current])
}

/// One season of one player at one university.
///
/// The roster feeds report a season at a time — and always did; the refresh
/// walked back year by year and added them up, keeping only the total and a
/// count of how many seasons it covered. So "how many minutes this season"
/// was being fetched and thrown away on every run. This is where each season
/// lands before anything is added up.
///
/// The columns on PlayerProfile stay as they are and keep meaning the same
/// thing: the career total at that university. They are now the sum of these
/// rows rather than a separate reading, so nothing that already reads them
/// has to change.
model ProfileSeasonStat {
  id        String        @id @default(cuid())
  profileId String
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// The calendar year the feed files the season under. NCAA soccer is an
  /// autumn sport, so 2025 is the season that runs into 2026 — the one the
  /// rest of the app calls "25/26".
  year Int
  /// That same season in the app's own words, for reading rather than joining.
  season String?

  matchesPlayed  Int?
  matchesStarted Int?
  minutes        Int?
  goals          Int?
  assists        Int?
  points         Int?
  saves          Int?
  goalsAgainst   Int?

  source         String? // "roster-site" | "ncaa-leaderboards"
  statsUpdatedAt DateTime?

  /// What this row said the last time it actually changed.
  ///
  /// The feeds report a season to date, never a list of goals with dates —
  /// so "who scored this week" cannot be read, only *noticed*, by comparing
  /// a refresh against the one before it. Keeping the previous figures on the
  /// row is enough for that and costs no history table.
  ///
  /// They only move when a figure moves. A refresh that finds nothing new
  /// leaves them alone, so a goal scored on Saturday is still visible as new
  /// after Sunday's run.
  prevGoals   Int?
  prevAssists Int?
  prevMinutes Int?
  prevMatches Int?
  prevAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per profile per season: a refresh replaces, never accumulates.
  @@unique([profileId, year])
  @@index([year])
}

// A revocable, expiring link that lets someone without an account edit one
// player's details. Scoped to a single player and a limited set of fields;
// every edit made through it is written to the audit trail.
model PlayerShareLink {
  id       String @id @default(cuid())
  token    String @unique
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("ShareLinkCreatedBy", fields: [createdById], references: [id])

  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?
  useCount   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([playerId])
}

// Immutable audit trail: who changed what, when (never auto-deleted).
model AuditLog {
  id         String   @id @default(cuid())
  entity     String // Player, ShowcaseUniversity, Claim, User
  entityId   String?
  entityName String? // human label (player name, university…)
  action     String // create, update, delete, bulk_update, bulk_delete, delete_all, import, approve, role_change…
  summary    String?
  changes    Json? // { field: { from, to } } or a summary object
  userId     String?
  userEmail  String?
  userName   String?
  createdAt  DateTime @default(now())

  @@index([entity])
  @@index([userId])
  @@index([createdAt])
}

// Universities that attended the annual Eture showcase, by year (2020–…)
model ShowcaseUniversity {
  id        String   @id @default(cuid())
  year      Int
  name      String
  order     Int      @default(0)
  logoUrl   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year])
}
